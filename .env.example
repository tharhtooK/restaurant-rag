DATABASE_URL="postgresql://app:app@db:5432/restaurant_rag?schema=public"

# OpenAI — agent (Responses API), eval judge, and embeddings
OPENAI_API_KEY=
# Optional: route OpenAI calls through a proxy (e.g. LiteLLM). Unset = api.openai.com
OPENAI_BASE_URL=

# Pinecone — semantic search over review chunks
# Index must be 1536 dimensions / cosine to match text-embedding-3-small
PINECONE_API_KEY=
PINECONE_INDEX=restaurants

# LangSmith — tracing for agent + judge calls (src/lib/openai.ts)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Traces land here. Keep this scoped to THIS project — pointing it at another
# app's project mixes unrelated traffic into that app's observability data.
LANGSMITH_PROJECT="restaurant-rag"

CRAWLER_URL=
CRAWLER_API_KEY=
CRAWLS_PER_DAY=5
