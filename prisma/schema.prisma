// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Conversation {
  id        String    @id @default(cuid())
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String   @db.Text
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Restaurant {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  neighborhood       String
  cuisine            String
  priceTier          Int
  address            String
  vegetarianFriendly Boolean  @default(false)
  dietary            String[] @default([])
  hours              Json
  /// "seed" or "crawled". The eval reads only "seed", so a crawl started from a
  /// chat turn cannot change what the goldens are graded against.
  dataset            String   @default("seed")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  reviews Review[]

  @@index([neighborhood])
  @@index([cuisine])
  @@index([priceTier])
  @@index([dataset])
}

model Review {
  id           String    @id @default(cuid())
  restaurantId String
  source       String
  content      String    @db.Text
  sourceUrl    String?
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}
